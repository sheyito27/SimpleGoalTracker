generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Goal {
  id            String  @id @default(uuid())
  title         String
  description   String
  startDate     DateTime
  endDate       DateTime
  isCompleted   Boolean @default(false)
  tasks         Task[]
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([title, userId])
}

model Task {
  id            String  @id @default(uuid())
  title         String
  description   String?
  startDate     DateTime
  isCompleted   Boolean @default(false)
  linkedGoalId  String
  goal          Goal    @relation(fields: [linkedGoalId], references: [id], onDelete: Cascade)

  @@unique([title, linkedGoalId])
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  passwordHash  String
  name          String
  email         String    @unique
  birthDate     DateTime  @db.Date
  createdAt     DateTime  @default(now())
  isActive      Boolean   @default(true)
  goals         Goal[]
}